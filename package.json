{
  "name": "logistics-financial-dashboard",
  "private": true,
  "version": "1.9.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:server": "tsc -p server/tsconfig.server.json && node scripts/write-dist-server-package.cjs",
    "build:electron": "npm run build && npm run build:server",
    "package:win": "npm run build:electron && electron-builder --win --config electron-builder.yml",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-win.ps1",
    "package:linux": "npm run build:electron && electron-builder --linux --config electron-builder.yml",
    "package:mac": "npm run build:electron && electron-builder --mac --config electron-builder.yml",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server release",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^42.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
