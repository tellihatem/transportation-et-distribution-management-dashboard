# ============================================================
# Logistics Financial Dashboard — Environment Configuration
# ============================================================

# Local Backend
PORT=3001
DATABASE_PATH=./data/logistics.db
NODE_ENV=development

# Auth is currently disabled (see server/index.ts) — this app is deployed
# to a single trusted client machine. These are unused unless the login
# gate (AuthGate.tsx / routes/auth.ts / middleware/auth.ts) is re-enabled.
APP_PASSWORD=change-me
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-too

# Production CORS — comma-separated list of allowed origins.
# Leave unset in dev; required if the frontend is hosted on a different
# origin than the API (not needed when Express serves both from one domain).
CORS_ORIGIN=https://your-production-domain.example

# Supabase Replica (Disaster Recovery) — optional, leave blank to disable sync
# Create a project at https://supabase.com and fill these in
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sync Configuration
SYNC_INTERVAL_MS=300000  # 5 minutes (in milliseconds)
