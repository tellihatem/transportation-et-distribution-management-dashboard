# ============================================================
# Logistics Financial Dashboard — Environment Configuration
# ============================================================

# Local Backend
PORT=3001
DATABASE_PATH=./data/logistics.db

# Supabase Replica (Disaster Recovery)
# Create a project at https://supabase.com and fill these in
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sync Configuration
SYNC_INTERVAL_MS=300000  # 5 minutes (in milliseconds)
